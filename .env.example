# CyberShield Environment Variables (Example template)

# Telegram Serverless Cloud Token (from @BotFather -> Serverless -> CLI Access)
TGCLOUD_TOKEN=app_your_token_here

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cybershield_db
DB_USER=postgres
DB_PASSWORD=postgres

# Security / JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend & Frontend Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
